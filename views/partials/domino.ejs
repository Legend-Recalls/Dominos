<%
/* Reusable domino tile renderer.
   Locals: top (0-6), bottom (0-6). Renders pips in the classic layout. */
function pips(n) {
    // Map a pip count to the set of position classes used.
    const map = {
        0: [],
        1: ['p-mc'],
        2: ['p-tl', 'p-br'],
        3: ['p-tl', 'p-mc', 'p-br'],
        4: ['p-tl', 'p-tr', 'p-bl', 'p-br'],
        5: ['p-tl', 'p-tr', 'p-mc', 'p-bl', 'p-br'],
        6: ['p-tl', 'p-tr', 'p-ml', 'p-mr', 'p-bl', 'p-br']
    };
    return (map[n] || []).map(c => `<span class="pip ${c}"></span>`).join('');
}
%>
<span class="domino" aria-hidden="true">
    <span class="half"><%- pips(typeof top === 'number' ? top : 0) %></span>
    <span class="half"><%- pips(typeof bottom === 'number' ? bottom : 0) %></span>
</span>
