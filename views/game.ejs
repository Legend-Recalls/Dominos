<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game — <%= game.tournament.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="content">
        <div class="page-head">
            <h1>🎲 Game Night</h1>
            <p>
                <a href="/tournament/<%= game.tournament._id %>" style="color:var(--brass);">
                    <%= game.tournament.name %>
                </a>
                · <%= new Date(game.date).toDateString() %> @ <%= game.time %> · to <%= game.maxpoints %> pts
            </p>
        </div>

        <div class="tile scoreboard">
            <table class="score-table" id="scoreTable">
                <thead>
                    <tr>
                        <th style="width:48px;"></th>
                        <% game.tournament.players.forEach(player => { %>
                            <th class="player-head" data-player="<%= player %>">
                                <span><%= player %></span>
                                <span class="lead-dot"></span>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody id="roundsBody"></tbody>
                <tfoot>
                    <tr class="entry-row">
                        <td class="round-index">+</td>
                        <% game.tournament.players.forEach(player => { %>
                            <td><input type="number" class="score-input" inputmode="numeric" placeholder="0"></td>
                        <% }) %>
                    </tr>
                    <tr class="total-row">
                        <th class="round-index">Σ</th>
                        <% game.tournament.players.forEach(player => { %>
                            <th><span class="total-value">0</span></th>
                        <% }) %>
                    </tr>
                </tfoot>
            </table>

            <div class="actions-row" style="margin-top:1.5rem; margin-bottom:0;">
                <button class="btn" id="addRoundBtn">➕ Add Round</button>
                <button class="btn btn-ghost" id="undoBtn">↩ Undo</button>
                <button class="btn btn-danger" id="endBtn">🏁 End Game</button>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/scoreboard.js"></script>
    <script>
        const board = window.initScoreboard({
            storageKey: 'arena-game-<%= game._id %>',
            initialRounds: <%- JSON.stringify(game.rounds) %>,
            endpoint: '/game/<%= game._id %>/end',
            onEnd: function (rounds, totals, ranking) {
                let msg = '🏁 Final ranking:\n\n';
                ranking.forEach((r, i) => { msg += `${i + 1}. ${r.name} — ${r.total}\n`; });
                setTimeout(() => alert(msg), 200);
            }
        });
    </script>
</body>
</html>
